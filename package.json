{
  "name": "filenote",
  "productName": "FileNote",
  "version": "1.6.1",
  "description": "FileNote — notas de la suite Razor",
  "author": "Felipe Franco",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "electron": "electron .",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "dependencies": {
    "@sentry/electron": "8.3.0",
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-highlight": "3.33.1",
    "@tiptap/extension-image": "3.33.1",
    "@tiptap/extension-mathematics": "3.33.1",
    "@tiptap/extension-placeholder": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/extension-task-item": "3.33.1",
    "@tiptap/extension-task-list": "3.33.1",
    "@tiptap/markdown": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@tiptap/suggestion": "3.33.1",
    "@types/d3-force": "3.0.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "d3-force": "3.0.0",
    "docx": "9.15.3",
    "electron": "45.2.0",
    "electron-builder": "26.15.3",
    "katex": "0.18.11",
    "lucide-react": "1.72.0",
    "minisearch": "7.2.0",
    "pdfjs-dist": "6.4.299",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "zustand": "5.1.0"
  },
  "build": {
    "appId": "com.felipefranco.razor.filenote",
    "productName": "FileNote",
    "copyright": "© 2026 FileNote",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FileNote",
      "artifactName": "FileNote-Setup-${version}.${ext}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "FileNote-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "FileNote ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Eva-one01/FileNote/releases/latest/download"
      }
    ]
  }
}
